{
	"name": "@vahor/shared",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		"./config": {
			"types": "./src/config/index.ts",
			"import": "./src/config/index.ts"
		},
		"./runner": {
			"types": "./src/runner/index.ts",
			"import": "./src/runner/index.ts"
		},
		"./trie": {
			"types": "./src/trie.ts",
			"import": "./src/trie.ts"
		}
	},
	"scripts": {
		"build": "bun run build:config && bun run build:runner",
		"build:config": "bun build --target=bun --outdir=dist/config src/config/index.ts --format=esm",
		"build:runner": "bun build --target=bun --outdir=dist/runner src/runner/index.ts --format=esm",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"effect": "^3.21.2"
	}
}
