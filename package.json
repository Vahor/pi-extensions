{
	"name": "@vahor/pi-extensions",
	"description": "Pi extensions monorepo for pi.",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Vahor",
		"email": "me@vahor.fr"
	},
	"packageManager": "bun@1.3.13",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vahor/pi-extensions.git"
	},
	"homepage": "https://github.com/Vahor/pi-extensions#readme",
	"bugs": {
		"url": "https://github.com/Vahor/pi-extensions/issues"
	},
	"workspaces": [
		"packages/*",
		"lib/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"dev": "bun run --filter '*' dev",
		"format": "bunx @biomejs/biome check ./ --write",
		"typecheck": "bun run --filter '*' typecheck",
		"schemas": "bun scripts/generate-config-schemas.ts && bunx @biomejs/biome format packages/*/schemas/*.json --write",
		"schemas:check": "bun run schemas && git diff --exit-code -- packages/pi-hooks/schemas/hooks.schema.json packages/pi-keymap/schemas/keymap.schema.json",
		"ci:version": "bunx @changesets/cli version && bun update",
		"ci:publish": "for dir in packages/*; do (cd \"$dir\" && bun run build && bun publish || true); done && bunx changeset tag"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.31.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^22.19.19",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3"
	}
}
