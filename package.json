{
	"name": "@vahor/pi-extensions",
	"private": true,
	"workspaces": [
		"packages/*",
		"lib/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"dev": "bun run --filter '*' dev",
		"format": "bunx @biomejs/biome check ./ --write",
		"typecheck": "bun run --filter '*' typecheck",
		"ci:version": "bunx @changesets/cli version && bun update",
		"ci:publish": "for dir in packages/*; do (cd \"$dir\" && bun run build && bun publish || true); done && bunx changeset tag"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.2",
		"@biomejs/biome": "^2.4.14",
		"@types/bun": "^1.3.13",
		"@types/node": "^22.0.0"
	}
}
