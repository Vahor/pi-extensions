{
	"name": "@vahor/pi-hooks",
	"version": "0.0.3",
	"type": "module",
	"main": "./dist/index.js",
	"files": [
		"dist"
	],
	"keywords": [
		"pi-package",
		"pi-extension",
		"hooks",
		"pi"
	],
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"scripts": {
		"build": "bun build --target=node --packages=bundle --outdir=dist --format=esm src/index.ts --minify",
		"dev": "bun run build && pi -e ./dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"effect": "^3.21.2"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"@vahor/shared": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
